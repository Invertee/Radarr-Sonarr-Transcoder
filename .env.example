NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# CSP frame-ancestors sources. The default permits same-origin and HTTPS iframe parents.
# For a stricter Home Assistant setup, use:
# FRAME_ANCESTORS='self' https://homeassistant.example.com
FRAME_ANCESTORS='self' https:

DATA_DIR=/var/lib/transcode-manager
CACHE_DIR=/var/cache/transcode-manager
LOG_DIR=/var/log/transcode-manager

# Applied only when a new SQLite database is created. Changing these values later
# will not overwrite statistics in an existing database.
STARTING_STATS_SAVED_GIB=1023.21
STARTING_STATS_EFFICIENCY_PERCENT=56.3
STARTING_STATS_FILES_PROCESSED=805

# Inactive transcode-job-* files older than this are removed automatically.
CACHE_RETENTION_HOURS=12

SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=

# Optional path translation when Sonarr/Radarr reports a different mount path.
SONARR_PATH_FROM=
SONARR_PATH_TO=
RADARR_PATH_FROM=
RADARR_PATH_TO=

DEFAULT_PROFILE=medium
VAAPI_DEVICE=/dev/dri/renderD128
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
AUDIO_BITRATE=192k
ARR_TIMEOUT_MS=10000
QUEUE_POLL_MS=1000
LOG_MAX_BYTES=5242880
